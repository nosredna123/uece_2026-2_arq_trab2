{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Billing result v1",
  "allOf": [
    {"$ref": "envelope.json"},
    {
      "properties": {
        "eventType": {"const": "billing.result"},
        "producer": {"const": "billing-mock"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "attemptId", "kind", "registrationId", "activityId", "organizationId", "status", "amountMinor", "currency"],
          "properties": {
            "operationId": {"type": "string", "format": "uuid"},
            "attemptId": {"type": "string", "format": "uuid"},
            "kind": {"enum": ["PAYMENT", "REFUND"]},
            "registrationId": {"type": "string", "format": "uuid"},
            "activityId": {"type": "string", "format": "uuid"},
            "organizationId": {"type": "string", "format": "uuid"},
            "status": {"enum": ["APPROVED", "REFUSED"]},
            "amountMinor": {"type": "integer", "minimum": 0},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
          }
        }
      }
    }
  ]
}
