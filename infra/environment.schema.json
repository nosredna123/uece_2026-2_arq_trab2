{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventHub required local environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "POSTGRES_USER", "POSTGRES_PASSWORD", "POSTGRES_PORT", "RABBITMQ_HOST", "RABBITMQ_PORT",
    "RABBITMQ_HOST_PORT", "RABBITMQ_MANAGEMENT_PORT", "RABBITMQ_USER", "RABBITMQ_PASSWORD",
    "EVENT_DATABASE_URL", "EVENT_DATABASE_USER", "EVENT_DATABASE_PASSWORD", "EVENT_MIGRATION_USER", "EVENT_MIGRATION_PASSWORD",
    "REGISTRATION_DATABASE_URL", "REGISTRATION_DATABASE_USER", "REGISTRATION_DATABASE_PASSWORD", "REGISTRATION_MIGRATION_USER", "REGISTRATION_MIGRATION_PASSWORD",
    "ATTENDANCE_DATABASE_URL", "ATTENDANCE_MIGRATION_DATABASE_URL", "REPORTING_DATABASE_URL", "REPORTING_MIGRATION_DATABASE_URL",
    "IDENTITY_BASE_URL", "IDENTITY_MOCK_AVAILABLE", "IDENTITY_LAB_ENABLED", "EVENT_MANAGEMENT_BASE_URL", "REGISTRATION_BASE_URL", "INTERNAL_SERVICE_KEY", "REGISTRATION_SERVICE_KEY", "HTTP_TIMEOUT_SECONDS",
    "RESERVATION_EXPIRY_MINUTES", "WAITLIST_ENABLED", "WAITLIST_OFFER_EXPIRY_MINUTES", "CANCELLATION_WINDOW_DAYS", "REFUND_PERCENTAGE",
    "CERTIFICATE_ELIGIBILITY_POLICY", "CERTIFICATE_ISSUANCE_AFTER_EVENT", "BILLING_MOCK_SCENARIO", "BILLING_MOCK_REFUND_SCENARIO", "BILLING_STORE_PATH",
    "NOTIFICATION_MOCK_AVAILABLE", "NOTIFICATION_STORE_PATH", "MESSAGE_RETRY_INITIAL_SECONDS", "MESSAGE_RETRY_MAX_SECONDS",
    "EVENT_MANAGEMENT_PORT", "REGISTRATION_PORT", "ATTENDANCE_PORT", "REPORTING_PORT"
  ],
  "properties": {
    "POSTGRES_USER": {"type": "string", "minLength": 1},
    "POSTGRES_PASSWORD": {"type": "string", "minLength": 1},
    "POSTGRES_PORT": {"$ref": "#/definitions/port"},
    "RABBITMQ_HOST": {"const": "rabbitmq"},
    "RABBITMQ_PORT": {"const": "5672"},
    "RABBITMQ_HOST_PORT": {"$ref": "#/definitions/port"},
    "RABBITMQ_MANAGEMENT_PORT": {"$ref": "#/definitions/port"},
    "RABBITMQ_USER": {"type": "string", "minLength": 1},
    "RABBITMQ_PASSWORD": {"type": "string", "minLength": 1},
    "EVENT_DATABASE_URL": {"type": "string", "pattern": "^jdbc:postgresql://postgres:5432/event_management$"},
    "EVENT_DATABASE_USER": {"type": "string", "minLength": 1},
    "EVENT_DATABASE_PASSWORD": {"type": "string", "minLength": 1},
    "EVENT_MIGRATION_USER": {"type": "string", "minLength": 1},
    "EVENT_MIGRATION_PASSWORD": {"type": "string", "minLength": 1},
    "REGISTRATION_DATABASE_URL": {"type": "string", "pattern": "^jdbc:postgresql://postgres:5432/registration$"},
    "REGISTRATION_DATABASE_USER": {"type": "string", "minLength": 1},
    "REGISTRATION_DATABASE_PASSWORD": {"type": "string", "minLength": 1},
    "REGISTRATION_MIGRATION_USER": {"type": "string", "minLength": 1},
    "REGISTRATION_MIGRATION_PASSWORD": {"type": "string", "minLength": 1},
    "ATTENDANCE_DATABASE_URL": {"type": "string", "pattern": "^postgresql\\+psycopg://[^:@/]+:[^@/]+@postgres:5432/attendance_certification$"},
    "ATTENDANCE_MIGRATION_DATABASE_URL": {"type": "string", "pattern": "^postgresql\\+psycopg://[^:@/]+:[^@/]+@postgres:5432/attendance_certification$"},
    "REPORTING_DATABASE_URL": {"type": "string", "pattern": "^postgresql\\+psycopg://[^:@/]+:[^@/]+@postgres:5432/reporting$"},
    "REPORTING_MIGRATION_DATABASE_URL": {"type": "string", "pattern": "^postgresql\\+psycopg://[^:@/]+:[^@/]+@postgres:5432/reporting$"},
    "IDENTITY_BASE_URL": {"const": "http://identity-mock:8080"},
    "IDENTITY_MOCK_AVAILABLE": {"enum": ["true", "false"]},
    "IDENTITY_LAB_ENABLED": {"enum": ["true", "false"]},
    "IDENTITY_LAB_FIXTURES_PATH": {"type": "string", "minLength": 1},
    "EVENT_MANAGEMENT_BASE_URL": {"const": "http://event-management:8080"},
    "REGISTRATION_BASE_URL": {"const": "http://registration:8080"},
    "INTERNAL_SERVICE_KEY": {"type": "string", "minLength": 1},
    "REGISTRATION_SERVICE_KEY": {"type": "string", "minLength": 1},
    "HTTP_TIMEOUT_SECONDS": {"$ref": "#/definitions/positive"},
    "RESERVATION_EXPIRY_MINUTES": {"$ref": "#/definitions/positive"},
    "WAITLIST_ENABLED": {"enum": ["true", "false"]},
    "WAITLIST_OFFER_EXPIRY_MINUTES": {"$ref": "#/definitions/positive"},
    "CANCELLATION_WINDOW_DAYS": {"$ref": "#/definitions/positive"},
    "REFUND_PERCENTAGE": {"type": "string", "pattern": "^(100|[1-9][0-9]?)$"},
    "CERTIFICATE_ELIGIBILITY_POLICY": {"const": "CHECK_IN"},
    "CERTIFICATE_ISSUANCE_AFTER_EVENT": {"const": "true"},
    "BILLING_MOCK_SCENARIO": {"enum": ["APPROVED", "REFUSED", "TIMEOUT"]},
    "BILLING_MOCK_REFUND_SCENARIO": {"enum": ["APPROVED", "REFUSED", "TIMEOUT"]},
    "BILLING_STORE_PATH": {"type": "string", "minLength": 1},
    "NOTIFICATION_MOCK_AVAILABLE": {"enum": ["true", "false"]},
    "NOTIFICATION_STORE_PATH": {"type": "string", "minLength": 1},
    "MESSAGE_RETRY_INITIAL_SECONDS": {"$ref": "#/definitions/positive"},
    "MESSAGE_RETRY_MAX_SECONDS": {"$ref": "#/definitions/positive"},
    "EVENT_MANAGEMENT_PORT": {"$ref": "#/definitions/port"},
    "REGISTRATION_PORT": {"$ref": "#/definitions/port"},
    "ATTENDANCE_PORT": {"$ref": "#/definitions/port"},
    "REPORTING_PORT": {"$ref": "#/definitions/port"},
    "DEMO_WEB_ENABLED": {"enum": ["true", "false"]},
    "DEMO_WEB_PORT": {"$ref": "#/definitions/port"},
    "DEMO_WEB_SESSION_TTL_SECONDS": {"$ref": "#/definitions/positive"},
    "DEMO_WEB_MAX_SESSIONS": {"$ref": "#/definitions/positive"},
    "DEMO_WEB_MAX_COMMANDS_PER_SESSION": {"$ref": "#/definitions/positive"},
    "DEMO_WEB_HISTORY_LIMIT": {"$ref": "#/definitions/positive"},
    "DEMO_WEB_POLL_INTERVAL_SECONDS": {"$ref": "#/definitions/positive"},
    "DEMO_WEB_POLL_TIMEOUT_SECONDS": {"$ref": "#/definitions/positive"},
    "DEMO_WEB_PAID_START_DELAY_SECONDS": {"$ref": "#/definitions/positive", "description": "Unused; accepted for older .env files."},
    "DEMO_WEB_ACTIVITY_DURATION_SECONDS": {"$ref": "#/definitions/positive", "description": "Unused; accepted for older .env files."},
    "DEMO_WEB_FREE_START_DELAY_SECONDS": {"$ref": "#/definitions/positive", "description": "Unused; accepted for older .env files."},
    "DEMO_WEB_EVENT_BASE_URL": {"const": "http://event-management:8080"},
    "DEMO_WEB_REGISTRATION_BASE_URL": {"const": "http://registration:8080"},
    "DEMO_WEB_ATTENDANCE_BASE_URL": {"const": "http://attendance:8080"},
    "DEMO_WEB_REPORTING_BASE_URL": {"const": "http://reporting:8080"},
    "DEMO_WEB_IDENTITY_FIXTURES_PATH": {"type": "string", "minLength": 1},
    "DEMO_LAB_ENABLED": {"enum": ["true", "false"]},
    "DEMO_LAB_FIXTURES_PATH": {"type": "string", "minLength": 1},
    "DEMO_LAB_MAX_PARTICIPANTS": {"type": "string", "pattern": "^([1-9]|[1-4][0-9]|50)$"},
    "DEMO_LAB_MAX_CONCURRENCY": {"type": "string", "pattern": "^([1-9]|10)$"},
    "DEMO_LAB_RUN_TIMEOUT_SECONDS": {"type": "string", "pattern": "^([1-9]|[1-5][0-9]|60)$"},
    "DEMO_LAB_SETTLE_TIMEOUT_SECONDS": {"type": "string", "pattern": "^([1-9]|[12][0-9]|30)$"},
    "DEMO_LAB_RUN_TTL_SECONDS": {"type": "string", "pattern": "^([1-9][0-9]{0,2}|1[0-7][0-9]{2}|1800)$"},
    "DEMO_LAB_MAX_RETAINED_RUNS": {"type": "string", "pattern": "^[1-5]$"},
    "REGISTRATION_OUTBOX_PUBLISH_INTERVAL_MS": {"type": "string", "pattern": "^([1-9][0-9]{2,3}|[12][0-9]{4}|30000)$"},
    "SCENARIO_PEAK_PARTICIPANTS": {"type": "string", "pattern": "^([1-9][0-9]{0,3}|1[0-9]{4}|20000)$"},
    "SCENARIO_PEAK_DURATION_SECONDS": {"type": "string", "pattern": "^([1-9]|[1-9][0-9]|[12][0-9]{2}|300)$"},
    "SCENARIO_MIXED_DURATION_SECONDS": {"type": "string", "pattern": "^([1-9][0-9]|[12][0-9]{2}|300)$"},
    "BILLING_MOCK_PAYMENT_REFUSAL_PERCENT": {"type": "string", "pattern": "^([0-9]|[1-9][0-9]|100)$"},
    "SCENARIO_CANCEL_PERCENT": {"type": "string", "pattern": "^([0-9]|[1-9][0-9]|100)$"},
    "SCENARIO_OFFER_LAPSE_PERCENT": {"type": "string", "pattern": "^([0-9]|[1-9][0-9]|100)$"},
    "SCENARIO_MAX_CONNECTIONS": {"type": "string", "pattern": "^([1-9]|[1-9][0-9]|1[0-9]{2}|200)$"},
    "SCENARIO_CHECK_IN_MIN_PERCENT": {"type": "string", "pattern": "^([0-9]|[1-9][0-9]|100)$"},
    "SCENARIO_CHECK_IN_MAX_PERCENT": {"type": "string", "pattern": "^([0-9]|[1-9][0-9]|100)$"},
    "SCENARIO_CERTIFICATE_MIN_PERCENT": {"type": "string", "pattern": "^([0-9]|[1-9][0-9]|100)$"},
    "SCENARIO_CERTIFICATE_MAX_PERCENT": {"type": "string", "pattern": "^([0-9]|[1-9][0-9]|100)$"}
  },
  "if": {
    "properties": {"DEMO_WEB_ENABLED": {"const": "true"}},
    "required": ["DEMO_WEB_ENABLED"]
  },
  "then": {
    "required": [
      "DEMO_WEB_PORT",
      "DEMO_WEB_SESSION_TTL_SECONDS",
      "DEMO_WEB_MAX_SESSIONS",
      "DEMO_WEB_MAX_COMMANDS_PER_SESSION",
      "DEMO_WEB_HISTORY_LIMIT",
      "DEMO_WEB_POLL_INTERVAL_SECONDS",
      "DEMO_WEB_POLL_TIMEOUT_SECONDS",
      "DEMO_WEB_EVENT_BASE_URL",
      "DEMO_WEB_REGISTRATION_BASE_URL",
      "DEMO_WEB_ATTENDANCE_BASE_URL",
      "DEMO_WEB_REPORTING_BASE_URL",
      "DEMO_WEB_IDENTITY_FIXTURES_PATH",
      "DEMO_LAB_ENABLED"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {"IDENTITY_LAB_ENABLED": {"const": "true"}},
        "required": ["IDENTITY_LAB_ENABLED"]
      },
      "then": {
        "properties": {
          "DEMO_WEB_ENABLED": {"const": "true"},
          "DEMO_LAB_ENABLED": {"const": "true"},
          "IDENTITY_LAB_FIXTURES_PATH": {"type": "string", "minLength": 1},
          "DEMO_LAB_FIXTURES_PATH": {"type": "string", "minLength": 1}
        },
        "required": [
          "DEMO_WEB_ENABLED",
          "DEMO_LAB_ENABLED",
          "IDENTITY_LAB_FIXTURES_PATH",
          "DEMO_LAB_FIXTURES_PATH",
          "DEMO_LAB_MAX_PARTICIPANTS",
          "DEMO_LAB_MAX_CONCURRENCY",
          "DEMO_LAB_RUN_TIMEOUT_SECONDS",
          "DEMO_LAB_SETTLE_TIMEOUT_SECONDS",
          "DEMO_LAB_RUN_TTL_SECONDS",
          "DEMO_LAB_MAX_RETAINED_RUNS"
        ]
      }
    },
    {
      "if": {
        "properties": {"DEMO_LAB_ENABLED": {"const": "true"}},
        "required": ["DEMO_LAB_ENABLED"]
      },
      "then": {
        "properties": {
          "IDENTITY_LAB_ENABLED": {"const": "true"}
        },
        "required": ["IDENTITY_LAB_ENABLED"]
      }
    }
  ],
  "definitions": {
    "positive": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "port": {"type": "string", "pattern": "^[1-9][0-9]{0,4}$"}
  }
}
