{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventHub required local environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "POSTGRES_USER", "POSTGRES_PASSWORD", "POSTGRES_PORT", "RABBITMQ_HOST", "RABBITMQ_PORT",
    "RABBITMQ_MANAGEMENT_PORT", "RABBITMQ_USER", "RABBITMQ_PASSWORD",
    "EVENT_DATABASE_URL", "EVENT_DATABASE_USER", "EVENT_DATABASE_PASSWORD", "EVENT_MIGRATION_USER", "EVENT_MIGRATION_PASSWORD",
    "REGISTRATION_DATABASE_URL", "REGISTRATION_DATABASE_USER", "REGISTRATION_DATABASE_PASSWORD", "REGISTRATION_MIGRATION_USER", "REGISTRATION_MIGRATION_PASSWORD",
    "ATTENDANCE_DATABASE_URL", "ATTENDANCE_MIGRATION_DATABASE_URL", "REPORTING_DATABASE_URL", "REPORTING_MIGRATION_DATABASE_URL",
    "IDENTITY_BASE_URL", "IDENTITY_MOCK_AVAILABLE", "EVENT_MANAGEMENT_BASE_URL", "REGISTRATION_BASE_URL", "INTERNAL_SERVICE_KEY", "HTTP_TIMEOUT_SECONDS",
    "RESERVATION_EXPIRY_MINUTES", "WAITLIST_ENABLED", "WAITLIST_OFFER_EXPIRY_MINUTES", "CANCELLATION_WINDOW_DAYS", "REFUND_PERCENTAGE",
    "CERTIFICATE_ELIGIBILITY_POLICY", "CERTIFICATE_ISSUANCE_AFTER_EVENT", "BILLING_MOCK_SCENARIO", "BILLING_MOCK_REFUND_SCENARIO", "BILLING_STORE_PATH",
    "NOTIFICATION_MOCK_AVAILABLE", "NOTIFICATION_STORE_PATH", "MESSAGE_RETRY_INITIAL_SECONDS", "MESSAGE_RETRY_MAX_SECONDS",
    "EVENT_MANAGEMENT_PORT", "REGISTRATION_PORT", "ATTENDANCE_PORT", "REPORTING_PORT", "IDENTITY_MOCK_PORT"
  ],
  "properties": {
    "POSTGRES_USER": {"type": "string", "minLength": 1},
    "POSTGRES_PASSWORD": {"type": "string", "minLength": 1},
    "POSTGRES_PORT": {"$ref": "#/definitions/port"},
    "RABBITMQ_HOST": {"type": "string", "minLength": 1},
    "RABBITMQ_PORT": {"$ref": "#/definitions/port"},
    "RABBITMQ_MANAGEMENT_PORT": {"$ref": "#/definitions/port"},
    "RABBITMQ_USER": {"type": "string", "minLength": 1},
    "RABBITMQ_PASSWORD": {"type": "string", "minLength": 1},
    "EVENT_DATABASE_URL": {"type": "string", "pattern": "^jdbc:postgresql://[^/]+/[^/]+$"},
    "EVENT_DATABASE_USER": {"type": "string", "minLength": 1},
    "EVENT_DATABASE_PASSWORD": {"type": "string", "minLength": 1},
    "EVENT_MIGRATION_USER": {"type": "string", "minLength": 1},
    "EVENT_MIGRATION_PASSWORD": {"type": "string", "minLength": 1},
    "REGISTRATION_DATABASE_URL": {"type": "string", "pattern": "^jdbc:postgresql://[^/]+/[^/]+$"},
    "REGISTRATION_DATABASE_USER": {"type": "string", "minLength": 1},
    "REGISTRATION_DATABASE_PASSWORD": {"type": "string", "minLength": 1},
    "REGISTRATION_MIGRATION_USER": {"type": "string", "minLength": 1},
    "REGISTRATION_MIGRATION_PASSWORD": {"type": "string", "minLength": 1},
    "ATTENDANCE_DATABASE_URL": {"$ref": "#/definitions/postgres"},
    "ATTENDANCE_MIGRATION_DATABASE_URL": {"$ref": "#/definitions/postgres"},
    "REPORTING_DATABASE_URL": {"$ref": "#/definitions/postgres"},
    "REPORTING_MIGRATION_DATABASE_URL": {"$ref": "#/definitions/postgres"},
    "IDENTITY_BASE_URL": {"$ref": "#/definitions/http"},
    "IDENTITY_MOCK_AVAILABLE": {"enum": ["true", "false"]},
    "EVENT_MANAGEMENT_BASE_URL": {"$ref": "#/definitions/http"},
    "REGISTRATION_BASE_URL": {"$ref": "#/definitions/http"},
    "INTERNAL_SERVICE_KEY": {"type": "string", "minLength": 1},
    "HTTP_TIMEOUT_SECONDS": {"$ref": "#/definitions/positive"},
    "RESERVATION_EXPIRY_MINUTES": {"$ref": "#/definitions/positive"},
    "WAITLIST_ENABLED": {"enum": ["true", "false"]},
    "WAITLIST_OFFER_EXPIRY_MINUTES": {"$ref": "#/definitions/positive"},
    "CANCELLATION_WINDOW_DAYS": {"$ref": "#/definitions/positive"},
    "REFUND_PERCENTAGE": {"type": "string", "pattern": "^(100|[1-9][0-9]?)$"},
    "CERTIFICATE_ELIGIBILITY_POLICY": {"const": "CHECK_IN"},
    "CERTIFICATE_ISSUANCE_AFTER_EVENT": {"const": "true"},
    "BILLING_MOCK_SCENARIO": {"enum": ["APPROVED", "REFUSED", "TIMEOUT"]},
    "BILLING_MOCK_REFUND_SCENARIO": {"enum": ["APPROVED", "REFUSED", "TIMEOUT"]},
    "BILLING_STORE_PATH": {"type": "string", "minLength": 1},
    "NOTIFICATION_MOCK_AVAILABLE": {"enum": ["true", "false"]},
    "NOTIFICATION_STORE_PATH": {"type": "string", "minLength": 1},
    "MESSAGE_RETRY_INITIAL_SECONDS": {"$ref": "#/definitions/positive"},
    "MESSAGE_RETRY_MAX_SECONDS": {"$ref": "#/definitions/positive"},
    "EVENT_MANAGEMENT_PORT": {"$ref": "#/definitions/port"},
    "REGISTRATION_PORT": {"$ref": "#/definitions/port"},
    "ATTENDANCE_PORT": {"$ref": "#/definitions/port"},
    "REPORTING_PORT": {"$ref": "#/definitions/port"},
    "IDENTITY_MOCK_PORT": {"$ref": "#/definitions/port"}
  },
  "definitions": {
    "positive": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "port": {"type": "string", "pattern": "^[1-9][0-9]{0,4}$"},
    "postgres": {"type": "string", "pattern": "^postgresql\\+psycopg://[^/]+/[^/]+$"},
    "http": {"type": "string", "pattern": "^https?://[^/]+(:[0-9]+)?/?$"}
  }
}
