# Synthetic local demonstration only. Never use these credentials outside the isolated prototype.
POSTGRES_USER=eventhub_bootstrap
POSTGRES_PASSWORD=synthetic-bootstrap-only
POSTGRES_PORT=5432
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=eventhub_demo
RABBITMQ_PASSWORD=synthetic-broker-only
EVENT_DATABASE_URL=jdbc:postgresql://postgres:5432/event_management
EVENT_DATABASE_USER=event_runtime
EVENT_DATABASE_PASSWORD=synthetic-event-runtime
EVENT_MIGRATION_USER=event_migration
EVENT_MIGRATION_PASSWORD=synthetic-event-migration
REGISTRATION_DATABASE_URL=jdbc:postgresql://postgres:5432/registration
REGISTRATION_DATABASE_USER=registration_runtime
REGISTRATION_DATABASE_PASSWORD=synthetic-registration-runtime
REGISTRATION_MIGRATION_USER=registration_migration
REGISTRATION_MIGRATION_PASSWORD=synthetic-registration-migration
ATTENDANCE_DATABASE_URL=postgresql+psycopg://attendance_runtime:synthetic-attendance-runtime@postgres:5432/attendance_certification
ATTENDANCE_MIGRATION_DATABASE_URL=postgresql+psycopg://attendance_migration:synthetic-attendance-migration@postgres:5432/attendance_certification
REPORTING_DATABASE_URL=postgresql+psycopg://reporting_runtime:synthetic-reporting-runtime@postgres:5432/reporting
REPORTING_MIGRATION_DATABASE_URL=postgresql+psycopg://reporting_migration:synthetic-reporting-migration@postgres:5432/reporting
IDENTITY_BASE_URL=http://identity-mock:8080
IDENTITY_MOCK_AVAILABLE=true
IDENTITY_LAB_ENABLED=false
IDENTITY_LAB_FIXTURES_PATH=/app/scenario-participants.json
EVENT_MANAGEMENT_BASE_URL=http://event-management:8080
REGISTRATION_BASE_URL=http://registration:8080
INTERNAL_SERVICE_KEY=synthetic-internal-service-only
REGISTRATION_SERVICE_KEY=synthetic-registration-service-only
HTTP_TIMEOUT_SECONDS=5
RESERVATION_EXPIRY_MINUTES=30
WAITLIST_ENABLED=true
WAITLIST_OFFER_EXPIRY_MINUTES=30
CANCELLATION_WINDOW_DAYS=7
REFUND_PERCENTAGE=90
CERTIFICATE_ELIGIBILITY_POLICY=CHECK_IN
CERTIFICATE_ISSUANCE_AFTER_EVENT=true
BILLING_MOCK_SCENARIO=APPROVED
BILLING_MOCK_REFUND_SCENARIO=APPROVED
BILLING_STORE_PATH=/data/billing.sqlite3
# Random delay before each payment result is published: N or MIN-MAX whole
# seconds, 0-60. Default 0 (instant); scripts/run-demo-web.sh uses 2-8 when the
# load scenarios are enabled and this is unset, so Reports shows pending payments.
# BILLING_MOCK_APPROVAL_DELAY_SECONDS=0
# Percentage (0-100) of payments the Billing mock refuses at random while
# BILLING_MOCK_SCENARIO=APPROVED. Default 0; scripts/run-demo-web.sh uses 10 when
# the load scenarios are enabled and this is unset, so Reports shows refusals.
# BILLING_MOCK_PAYMENT_REFUSAL_PERCENT=0
NOTIFICATION_MOCK_AVAILABLE=true
NOTIFICATION_STORE_PATH=/data/notification.sqlite3
MESSAGE_RETRY_INITIAL_SECONDS=1
MESSAGE_RETRY_MAX_SECONDS=60
# How often Registration relays its outbox (registration events to Reporting),
# 100-30000 ms. Default 30000; scripts/run-demo-web.sh uses 1000 when unset so
# the organizer Reports page follows registrations almost in real time.
# REGISTRATION_OUTBOX_PUBLISH_INTERVAL_MS=30000
EVENT_MANAGEMENT_PORT=8081
REGISTRATION_PORT=8082
ATTENDANCE_PORT=8083
REPORTING_PORT=8084
# Optional presentation client. Keep disabled for backend-only operation.
DEMO_WEB_ENABLED=false
DEMO_LAB_ENABLED=false
DEMO_WEB_PORT=8085
DEMO_WEB_SESSION_TTL_SECONDS=3600
DEMO_WEB_MAX_SESSIONS=100
DEMO_WEB_MAX_COMMANDS_PER_SESSION=20
DEMO_WEB_HISTORY_LIMIT=20
DEMO_WEB_POLL_INTERVAL_SECONDS=2
DEMO_WEB_POLL_TIMEOUT_SECONDS=60
DEMO_WEB_EVENT_BASE_URL=http://event-management:8080
DEMO_WEB_REGISTRATION_BASE_URL=http://registration:8080
DEMO_WEB_ATTENDANCE_BASE_URL=http://attendance:8080
DEMO_WEB_REPORTING_BASE_URL=http://reporting:8080
DEMO_WEB_IDENTITY_FIXTURES_PATH=/run/eventhub/identity-fixtures.json
# Required only when both lab flags are true.
# DEMO_LAB_FIXTURES_PATH=/run/eventhub/scenario-participants.json
# DEMO_LAB_MAX_PARTICIPANTS=50
# DEMO_LAB_MAX_CONCURRENCY=10
# DEMO_LAB_RUN_TIMEOUT_SECONDS=60
# DEMO_LAB_SETTLE_TIMEOUT_SECONDS=30
# DEMO_LAB_RUN_TTL_SECONDS=1800
# DEMO_LAB_MAX_RETAINED_RUNS=5
# Load scenarios run by scripts/cenario.sh (requires both lab flags).
SCENARIO_PEAK_PARTICIPANTS=20
SCENARIO_PEAK_DURATION_SECONDS=30
# Duration of `bash scripts/cenario.sh` with no argument (all scenarios in parallel).
SCENARIO_MIXED_DURATION_SECONDS=60
# Mixed load (`bash scripts/cenario.sh` with no argument): each activity draws its
# own check-in rate and certificate rate uniformly between MIN and MAX, so the
# Reports panel shows different numbers in every run. Integers 0-100; MIN must
# not exceed MAX; set MIN = MAX for a fixed rate.
# Check-in: percentage of the confirmed registrations that check in during the activity.
SCENARIO_CHECK_IN_MIN_PERCENT=40
SCENARIO_CHECK_IN_MAX_PERCENT=90
# Certificate: percentage of the checked-in participants that receive a certificate
# after the activity ends.
SCENARIO_CERTIFICATE_MIN_PERCENT=50
SCENARIO_CERTIFICATE_MAX_PERCENT=100
# Cancellation: percentage of registrations in free activities that the participant
# cancels before the activity starts (paid activities are never cancelled, see the
# REFUND limitation). Integer 0-100, default 20.
SCENARIO_CANCEL_PERCENT=20
# Ignored offers: percentage of waiting-list offers the participant does not accept.
# Registration marks them EXPIRED after WAITLIST_OFFER_EXPIRY_MINUTES and offers the
# seat to the next person. Integer 0-100, default 20.
SCENARIO_OFFER_LAPSE_PERCENT=20
