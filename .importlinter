[importlinter]
root_packages =
    attendance_service
    reporting_service
    identity_access_mock
    billing_mock
    notification_mock
    demo_web
include_external_packages = True
exclude_type_checking_imports = True

[importlinter:contract:service-boundaries]
name = Services and mocks are independent packages
type = independence
modules =
    attendance_service
    reporting_service
    identity_access_mock
    billing_mock
    notification_mock
    demo_web
